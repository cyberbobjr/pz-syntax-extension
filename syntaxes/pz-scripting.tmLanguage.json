{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Project Zomboid Script",
  "scopeName": "source.pz-script",
  "patterns": [
    { "include": "#comments" },
    { "include": "#module" },
    { "include": "#recipe-line" },
    { "include": "#block-header" },
    { "include": "#property" },
    { "include": "#values" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.pz",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.pz" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.pz" } }
        },
        {
          "comment": "The game has no line comments: // text is read as script.",
          "name": "invalid.illegal.line-comment.pz",
          "match": "(?<=^|[\\s,{}])//.*$"
        }
      ]
    },
    "module": {
      "match": "^\\s*(module)\\s+(\\w+)",
      "captures": {
        "1": { "name": "keyword.control.module.pz" },
        "2": { "name": "entity.name.namespace.pz" }
      }
    },
    "block-header": {
      "comment": "A line holding only `type` or `type name`, optionally followed by {",
      "match": "^\\s*([A-Za-z_][\\w]*)(?:\\s+([^=,;\\[\\]{}:/]*[^=,;\\[\\]{}:/\\s]))?\\s*(\\{)?\\s*$",
      "captures": {
        "1": { "name": "storage.type.block.pz" },
        "2": { "name": "entity.name.type.pz" },
        "3": { "name": "punctuation.section.block.begin.pz" }
      }
    },
    "recipe-line": {
      "comment": "craftRecipe inputs/outputs: item 1 [Base.Plank] mode:keep flags[Prop1]",
      "begin": "^\\s*([+-]?(?:item|fluid|energy))\\s+(?=\\.?\\d|variable\\[)",
      "end": "(,)|(?=\\})|$",
      "beginCaptures": { "1": { "name": "keyword.other.recipe-resource.pz" } },
      "endCaptures": { "1": { "name": "punctuation.separator.comma.pz" } },
      "patterns": [
        { "include": "#comments" },
        {
          "match": "\\b(tags|flags|categories|mappers)(?=\\[)",
          "name": "keyword.other.recipe-list.pz"
        },
        {
          "match": "\\b(mode|mapper|chance|shapedIndex|apply)(:)(\\w*)",
          "captures": {
            "1": { "name": "keyword.other.recipe-option.pz" },
            "2": { "name": "punctuation.separator.key-value.pz" },
            "3": { "name": "constant.language.recipe-option.pz" }
          }
        },
        { "match": "\\b(variable|overlayMapper)\\b", "name": "keyword.other.pz" },
        { "include": "#values" },
        { "include": "#punctuation" }
      ]
    },
    "property": {
      "match": "^\\s*([\\w.]+!?)\\s*(=|:(?!\\S*\\]))",
      "captures": {
        "1": { "name": "support.type.property-name.pz" },
        "2": { "name": "punctuation.separator.key-value.pz" }
      }
    },
    "values": {
      "patterns": [
        { "match": "\\b(?i:true|false)\\b", "name": "constant.language.boolean.pz" },
        { "match": "(?<![\\w.])-?\\d+(\\.\\d+)?(?![\\w.])", "name": "constant.numeric.pz" },
        {
          "comment": "Build 42 namespaced ids: base:hammer",
          "match": "\\b([a-z][\\w]*)(:)([a-z][\\w/]*)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.pz" },
            "2": { "name": "punctuation.separator.namespace.pz" },
            "3": { "name": "variable.other.constant.pz" }
          }
        },
        {
          "comment": "Module.Object references: Base.Plank",
          "match": "\\b([A-Z][\\w]*)(\\.)([\\w]+)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.pz" },
            "2": { "name": "punctuation.accessor.pz" },
            "3": { "name": "entity.name.class.pz" }
          }
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "match": "\\{", "name": "punctuation.section.block.begin.pz" },
        { "match": "\\}", "name": "punctuation.section.block.end.pz" },
        { "match": "\\[|\\]", "name": "punctuation.section.brackets.pz" },
        { "match": ";", "name": "punctuation.separator.list.pz" },
        { "match": ",", "name": "punctuation.separator.comma.pz" }
      ]
    }
  }
}
