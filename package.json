{
  "name": "pz-syntax-extension",
  "displayName": "Project Zomboid Script Support",
  "description": "Project Zomboid Build 42.21 script support: syntax highlighting, validation against the game, completion, hover docs, go to definition, outline and formatting for items, recipes, entities, fluids, vehicles and every other script block.",
  "version": "0.3.0",
  "publisher": "cyberbobjr",
  "author": "cyberbobjr",
  "license": "MIT",
  "icon": "images/pz-script.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberbobjr/pz-syntax-extension"
  },
  "bugs": {
    "url": "https://github.com/cyberbobjr/pz-syntax-extension/issues"
  },
  "homepage": "https://github.com/cyberbobjr/pz-syntax-extension#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "project zomboid",
    "zomboid",
    "pz",
    "build 42",
    "modding",
    "script",
    "craftRecipe",
    "items"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:pz-scripting",
    "onLanguage:plaintext"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pz-scripting",
        "aliases": [
          "Project Zomboid Script",
          "pz-script"
        ],
        "filenamePatterns": [
          "**/media/scripts/**/*.txt"
        ],
        "firstLine": "^\\s*module\\s+\\w+\\s*\\{?",
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/pz-script.png",
          "dark": "./images/pz-script.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "pz-scripting",
        "scopeName": "source.pz-script",
        "path": "./syntaxes/pz-scripting.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pzSyntaxExtension.reindex",
        "title": "Re-index scripts",
        "category": "PZ Script"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Project Zomboid Script",
      "properties": {
        "pzSyntaxExtension.searchDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Script folders indexed for go to definition, hovers and id completion (vanilla scripts, other mods). Empty: the `media/scripts` folder of the game, found through Steam. The workspace `media/scripts` files are always indexed."
        },
        "pzSyntaxExtension.pzFilenames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "console.txt"
          ],
          "description": "File names (regular expressions allowed) to treat as Project Zomboid scripts."
        },
        "pzSyntaxExtension.diagnostics.unknownProperties": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "description": "How to report properties the game does not read."
        },
        "pzSyntaxExtension.diagnostics.unknownValues": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "information",
          "description": "How to report values missing from the game registries (tags, body locations, categories…). Mods can register new values."
        },
        "pzSyntaxExtension.format.alignValues": {
          "type": "boolean",
          "default": true,
          "description": "Align the = of consecutive properties when formatting."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "coverage": "npm run compile && node --test --experimental-test-coverage out/test/*.test.js",
    "generate-schema": "npm run compile && node tools/generate-schema.js",
    "package": "vsce package",
    "publish": "vsce publish",
    "test:integration": "npm run compile && node out/integration/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
